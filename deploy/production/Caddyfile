vibeyastudio.com, www.vibeyastudio.com {
  tls /etc/caddy/certs/www.vibeyastudio.com.pem /etc/caddy/certs/www.vibeyastudio.com.key
  encode zstd gzip
  reverse_proxy storefront:8000
}

api.vibeyastudio.com {
  tls /etc/caddy/certs/api.vibeyastudio.com.pem /etc/caddy/certs/api.vibeyastudio.com.key
  reverse_proxy backend:9000
}
