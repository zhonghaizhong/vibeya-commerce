# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=us

# Base URL used for storefront requests and UCP operations.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Public canonical domain used for metadata, JSON-LD, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://vibeyastudio.com

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Payments publishable key (optional, set automatically on Medusa Cloud)
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=

# Adyen client key (optional, only if using Adyen). Add the storefront's URL to the
# client key's allowed origins in the Adyen Customer Area.
NEXT_PUBLIC_ADYEN_CLIENT_KEY=

# Adyen environment, test or live (optional, only if using Adyen)
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development

NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Cloudflare Turnstile: public browser widget key and private server verification key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
